{
  "name": "@charonx/dsh-plugins",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "e2e": "pnpm -r --if-present run e2e",
    "check:hygiene": "node scripts/check-repo-hygiene.mjs",
    "test:release": "node --test scripts/release-targets.test.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@playwright/test": "^1.65.0",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charonX/dsh-plugins.git"
  }
}
