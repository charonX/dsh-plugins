{
  "name": "@charonx/dsh-autoloop",
  "version": "0.1.0",
  "description": "Autoloop microkernel and monitor for DeepSeek Harness: event sourcing, zero-cost suspension, prompt-data separation, hop limit circuit breaker, and live Kanban UI.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "autoloop",
    "microkernel",
    "orchestrator"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsc -p tsconfig.host.json",
    "build:client": "tsdown",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.2.2-alpha.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1",
    "@deepseek-ai/schemastery": "~3.18.6-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-alpha.3",
    "@deepseek-ai/schemastery": "~3.18.6-alpha.2",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "author": "charonX",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charonX/dsh-plugins.git",
    "directory": "plugins/autoloop"
  }
}
