{
  "name": "@charonx/dsh-model-studio",
  "version": "0.0.1",
  "description": "Model layer studio for DeepSeek Harness: provider presets, endpoint compat (thinking dialect) editing, probe-and-remember for unknown gateways, and per-model reasoning defaults.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "GLOSSARY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-alpha.3 <0.3.0"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "provider",
    "model",
    "reasoning-effort",
    "compat",
    "thinking"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  },
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsc -p tsconfig.host.json",
    "build:client": "tsdown",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:models-dev": "node scripts/sync-models-dev.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1",
    "@deepseek-ai/dsh-llm": ">=0.2.2-alpha.3 <0.3.0",
    "@deepseek-ai/dsh-settings": ">=0.2.2-alpha.3 <0.3.0",
    "@deepseek-ai/schemastery": "~3.18.6-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-settings-models": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-settings": "0.2.2-alpha.3",
    "@deepseek-ai/schemastery": "~3.18.6-alpha.2",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "charonX",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charonX/dsh-plugins.git",
    "directory": "plugins/model-studio"
  }
}
