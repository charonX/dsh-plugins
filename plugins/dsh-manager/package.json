{
  "name": "@charonx/dsh-manager",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Dsh Manager: external Trigger intake and a Steward ticket board for DeepSeek Harness",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./remote": {
      "types": "./lib/remote.d.ts",
      "default": "./lib/remote.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "playbooks",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "GLOSSARY.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "manager",
    "steward",
    "triggers"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "pnpm run build:host && pnpm run build:remote && pnpm run build:client",
    "build:host": "tsdown --config tsdown.host.config.ts",
    "build:remote": "tsdown --config tsdown.remote.config.ts",
    "build:client": "tsdown --config tsdown.client.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "test:watch": "vitest",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.2-rc.2 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "~3.19.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/cordis-plugin-include": "~1.1.0",
    "@deepseek-ai/cordis-plugin-loader": "~1.1.0",
    "@deepseek-ai/dsh": "0.2.2-rc.4",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.4",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.4",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.4",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.4",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-test-runtime": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.4",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.4",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.4",
    "@deepseek-ai/dsh-remote-mock": "0.2.2-rc.4",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-rc.4",
    "@deepseek-ai/dsh-session": "0.2.2-rc.4",
    "@deepseek-ai/dsh-storage": "0.2.2-rc.4",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.4",
    "@deepseek-ai/dsh-storage-json": "0.2.2-rc.4",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.4",
    "@deepseek-ai/dsh-tool-present": "0.2.2-rc.4",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.4",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.4",
    "@deepseek-ai/dsh-util-time": "0.2.2-rc.4",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.4",
    "@deepseek-ai/dsh-workspace-changes": "0.2.2-rc.4",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@lexical/headless": "^0.49.0",
    "@lexical/history": "^0.49.0",
    "@lexical/plain-text": "^0.49.0",
    "@lexical/text": "^0.49.0",
    "@lexical/utils": "^0.49.0",
    "@playwright/test": "^1.65.0",
    "@shikijs/langs": "^4.6.0",
    "@tanstack/react-virtual": "3.14.10",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@tsdown/css": "^0.23.7",
    "@types/node": "^24.19.2",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "anser": "^2.3.5",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "immer": "^10.2.0",
    "jsdom": "29.1.1",
    "lexical": "^0.49.0",
    "lightningcss": "^1.33.0",
    "mime-types": "^3.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "shiki": "^4.6.0",
    "simple-icons": "16.31.0",
    "tsdown": "0.22.14",
    "tsx": "4.20.3",
    "typescript": "6.0.3",
    "use-sync-external-store": "1.6.0",
    "vitest": "4.1.8",
    "zod": "4.6.6",
    "zustand": "~4.5.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "charonX",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charonX/dsh-plugins.git",
    "directory": "plugins/dsh-manager"
  }
}
