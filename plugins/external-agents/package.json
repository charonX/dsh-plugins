{
  "name": "@charonx/dsh-external-agents",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Session-level third-party coding agent runtime for DeepSeek Harness (agy via ACP, Claude Code, Pi Agent, Codex) with composer switching, session lock, model selection, and Subagent sharing.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./remote": {
      "types": "./lib/remote.d.ts",
      "default": "./lib/remote.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "external-agents",
    "acp",
    "agy",
    "claude-code",
    "pi",
    "codex"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "pnpm run build:host && pnpm run build:remote && pnpm run build:client",
    "build:host": "tsdown --config tsdown.host.config.ts",
    "build:remote": "tsdown --config tsdown.remote.config.ts",
    "build:client": "tsdown --config tsdown.client.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.2 <0.3.0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.2-rc.2 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.2-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "~3.19.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.4",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.4",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.4",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.4",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.4",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.4",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-session-panel": "0.2.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-session-status": "0.2.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.4",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.4",
    "@deepseek-ai/dsh-session": "0.2.2-rc.4",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.4",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.4",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.4",
    "@deepseek-ai/dsh-subprocess-local": "0.2.2-rc.4",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.4",
    "@deepseek-ai/dsh-token-meter": "0.2.2-rc.4",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.4",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.4",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.4",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@tsdown/css": "^0.23.7",
    "@types/node": "^24.19.2",
    "@types/react": "18.3.28",
    "@types/react-dom": "~18.3.7",
    "lightningcss": "^1.32.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "zod": "4.6.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "charonX",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charonX/dsh-plugins.git",
    "directory": "plugins/external-agents"
  }
}
